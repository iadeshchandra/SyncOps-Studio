rules_version = '2';

// SyncOps Studio — Firestore security rules.
// Deny-by-default. Intake orders are creatable by anyone (strictly validated
// shape — Deep Review #2, Batch 1: creation-time forgery closed); order reads
// are scoped to the owning client email; order updates are owner-only except
// two narrow client paths (the access checklist, and responding to a
// delivery); platformConfig/admins.owners is the owner allowlist — the doc
// must be bootstrapped by hand in the Firebase console (see docs/DEPLOY.md)
// before the first owner sign-in, otherwise isOwner() denies (fail-closed).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Order access requires a VERIFIED email (Deep Review #2, A2/C-02):
    // an address alone is not identity — whoever merely registers with an
    // order's email must not inherit that client's portal. Google sign-ins
    // carry email_verified=true inherently. The owner allowlist (isOwner)
    // is a separate control and is not gated on this.
    function ownsOrder(orderId) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/orders/$(orderId)).data.clientEmail
             == request.auth.token.email;
    }

    function isOwner() {
      return isSignedIn()
        && request.auth.token.email
             in get(/databases/$(database)/documents/platformConfig/admins).data.owners;
    }

    // Studio-wide configuration (site settings, pricing, case studies, ...)
    // `public` is world-readable so the marketing site can render owner-
    // published config without auth; everything else is owner-only.
    match /platformConfig/{docId} {
      // 'payment' holds the studio's receiving details (e.g. the bKash QR) —
      // visible to signed-in clients only, never to the public internet.
      allow read: if docId == 'public'
        || (docId == 'payment' && isSignedIn())
        || isOwner();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // Product showcase CMS — one doc per app. World-readable so /work
    // renders without auth; writes are owner-only via the Studio Console.
    match /platformConfig/products/items/{productId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Field-notes CMS — one doc per article. World-readable so /notes
    // renders without auth; writes are owner-only via the Studio Console.
    match /platformConfig/articles/items/{articleId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Client projects / intake orders
    match /orders/{orderId} {
      // Public intake (the hire form) may create an order ONLY in the exact
      // shape the form sends: no payment ledger, no price, no status other
      // than 'intake', no pre-written timeline beyond the client's own
      // "order placed" entry. The owner (console "New order") is exempt.
      allow create: if isOwner()
        || (request.resource.data.keys().hasOnly([
              'clientName', 'clientEmail', 'brandUrl', 'packageId',
              'packageName', 'ref', 'serviceLine', 'scope', 'status',
              'stageIndex', 'adSpend', 'primaryNetworks', 'targetLaunchDate',
              'notes', 'createdAt', 'deadlineAt', 'activity', 'revisions',
              'roas', 'projectedRecovery'
            ])
            && request.resource.data.keys().hasAll(
              ['clientName', 'clientEmail', 'brandUrl', 'packageId', 'status', 'createdAt']
            )
            && request.resource.data.clientEmail is string
            && request.resource.data.status == 'intake'
            && request.resource.data.stageIndex == 0
            && request.resource.data.activity is list
            && request.resource.data.activity.size() <= 1
            && (request.resource.data.activity.size() == 0
                || request.resource.data.activity[0].by == 'client')
            && request.resource.data.revisions is list
            && request.resource.data.revisions.size() == 0);

      allow read: if isOwner()
        || (isSignedIn()
            && request.auth.token.email_verified == true
            && request.auth.token.email == resource.data.clientEmail);

      // Milestone/stage transitions happen via the Studio Console only.
      // The owning client gets exactly two narrow exceptions:
      //  (a) saving the access checklist — that field alone;
      //  (b) responding to a delivery — status plus EXACTLY ONE appended
      //      timeline entry, written by 'client', of a delivery kind, with
      //      every earlier entry preserved word-for-word.
      allow update: if isOwner()
        || (ownsOrder(orderId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['checklist']))
        || (ownsOrder(orderId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['activity', 'status'])
            && request.resource.data.status in ['completed', 'active']
            && request.resource.data.activity is list
            && resource.data.activity is list
            && request.resource.data.activity.size() == resource.data.activity.size() + 1
            && request.resource.data.activity.hasAll(resource.data.activity)
            && request.resource.data.activity[request.resource.data.activity.size() - 1].by == 'client'
            && request.resource.data.activity[request.resource.data.activity.size() - 1].kind
                 in ['delivery_accepted', 'delivery_revision']);
      allow delete: if isOwner();

      // Lead Architect <-> Client channel. The sender label is bound to the
      // writer's role: a client can only ever send as 'client', the owner
      // only as 'architect' — impersonation is denied by the rules.
      match /messages/{messageId} {
        allow read: if isOwner()
          || (resource.data.orderId == orderId && ownsOrder(orderId));
        allow create: if request.resource.data.keys().hasOnly(['orderId', 'sender', 'body', 'createdAt'])
          && request.resource.data.orderId == orderId
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000
          && ((isOwner() && request.resource.data.sender == 'architect')
              || (ownsOrder(orderId) && request.resource.data.sender == 'client'));
        allow update, delete: if false;
      }

      // Scope revision requests
      match /revisions/{revisionId} {
        allow read: if ownsOrder(orderId) || isOwner();
        allow create: if ownsOrder(orderId)
          && request.resource.data.keys().hasOnly(['type', 'details', 'createdAt', 'status'])
          && request.resource.data.keys().hasAll(['type', 'details', 'createdAt', 'status'])
          && request.resource.data.status == 'pending'
          && request.resource.data.details is string;
        allow update: if isOwner();
        allow delete: if false;
      }

      // Deliveries — the architect submits; the client accepts or sends back.
      match /deliveries/{deliveryId} {
        allow read: if ownsOrder(orderId) || isOwner();
        allow create: if isOwner()
          && request.resource.data.keys().hasOnly(['note', 'links', 'createdAt', 'status'])
          && request.resource.data.keys().hasAll(['note', 'links', 'createdAt', 'status'])
          && request.resource.data.status == 'pending';
        allow update: if isOwner()
          || (ownsOrder(orderId)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'responseNote', 'respondedAt'])
              && request.resource.data.status in ['accepted', 'revision']);
        allow delete: if false;
      }

      // Shared order files (Zero-Cost File Vault pattern): small files stored
      // as data in documents — no Firebase Storage, no paid plan. The
      // uploadedBy label is bound to the writer's role, and the stored size
      // is capped in the rules themselves (not only in client code).
      match /files/{fileId} {
        allow read: if ownsOrder(orderId) || isOwner();
        allow create: if request.resource.data.keys().hasOnly(
              ['name', 'mime', 'size', 'dataUrl', 'uploadedBy', 'createdAt'])
          && request.resource.data.keys().hasAll(
              ['name', 'mime', 'size', 'dataUrl', 'uploadedBy', 'createdAt'])
          && request.resource.data.size is number
          && request.resource.data.size <= 1000000
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() <= 1000000
          && ((isOwner() && request.resource.data.uploadedBy == 'architect')
              || (ownsOrder(orderId) && request.resource.data.uploadedBy == 'client'));
        allow delete: if isOwner()
          || (ownsOrder(orderId) && resource.data.uploadedBy == 'client');
        allow update: if false;
      }

      // Payment claims — the client pays OUTSIDE the app (bKash Send Money,
      // Wise, …) and claims it here; the owner verifies and approves, which
      // is what credits the order's payment ledger. Coordination, never
      // custody. A claim is created in one exact shape: pending, a real
      // amount, a supported currency, a plausible transaction reference —
      // and it can never carry a pre-decided outcome.
      match /claims/{claimId} {
        allow read: if ownsOrder(orderId) || isOwner();
        allow create: if ownsOrder(orderId)
          && request.resource.data.keys().hasOnly(
              ['amount', 'currency', 'method', 'trxId', 'sender', 'note', 'status', 'createdAt'])
          && request.resource.data.keys().hasAll(
              ['amount', 'currency', 'method', 'trxId', 'status', 'createdAt'])
          && request.resource.data.status == 'pending'
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.currency in ['BDT', 'INR', 'USD']
          && request.resource.data.trxId is string
          && request.resource.data.trxId.size() >= 4;
        allow update: if isOwner();
        allow delete: if false;
      }

      // Intake / requirements form — the client's own answers, written before
      // the project starts (access notes, ad account IDs, goals). The client
      // writes exactly one document: 'form'.
      match /intake/{docId} {
        allow read: if ownsOrder(orderId) || isOwner();
        allow create, update: if isOwner()
          || (ownsOrder(orderId) && docId == 'form');
        allow delete: if false;
      }
    }

    // Public proof: verified historical metrics
    match /case_studies/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Completion reviews — one per order (doc id == order id). A client may
    // write a review only for their OWN order, only once that order is
    // completed, always unpublished, always under their name. The owner
    // publishes; the public reads only published ones.
    match /reviews/{reviewId} {
      allow read: if isOwner() || resource.data.published == true || ownsOrder(reviewId);
      allow create: if ownsOrder(reviewId)
        && get(/databases/$(database)/documents/orders/$(reviewId)).data.status == 'completed'
        && request.resource.data.keys().hasOnly(
            ['orderId', 'clientName', 'rating', 'text', 'createdAt', 'published'])
        && request.resource.data.keys().hasAll(
            ['orderId', 'clientName', 'rating', 'text', 'createdAt', 'published'])
        && request.resource.data.orderId == reviewId
        && request.resource.data.published == false
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() > 0
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    // Client roster records (private studio notes) — owner eyes only
    match /clients/{clientId} {
      allow read, write: if isOwner();
    }

    // Operational audit trail — owner eyes only
    match /audit_logs/{docId} {
      allow read: if isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }

    // Audit report leads — anyone may leave their email (create-only, no PII reads),
    // only the owner may read or delete. No listing for strangers, no updates.
    match /leads/{leadId} {
      allow read: if isOwner();
      allow create: if request.resource.data.keys().hasOnly(['email', 'domain', 'score', 'grade', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 160;
      allow update, delete: if isOwner();
    }
  }
}
