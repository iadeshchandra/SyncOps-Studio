rules_version = '2';

// SyncOps Studio — Firestore security rules.
// Deny-by-default. Intake orders are creatable by anyone (validated shape);
// order reads are scoped to the owning client email; order updates are
// owner-only (milestone/stage transitions from the Studio Console);
// platformConfig/admins.owners is the owner allowlist — the doc must be
// bootstrapped by hand in the Firebase console (see docs/DEPLOY.md) before
// the first owner sign-in, otherwise isOwner() denies (fail-closed).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function ownsOrder(orderId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/orders/$(orderId)).data.clientEmail
             == request.auth.token.email;
    }

    function isOwner() {
      return isSignedIn()
        && request.auth.token.email
             in get(/databases/$(database)/documents/platformConfig/admins).data.owners;
    }

    // Studio-wide configuration (site settings, pricing, case studies, ...)
    // `public` is world-readable so the marketing site can render owner-
    // published config without auth; everything else is owner-only.
    match /platformConfig/{docId} {
      allow read: if docId == 'public' || isOwner();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // Client projects / intake orders
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(
          ['clientName', 'clientEmail', 'brandUrl', 'packageId', 'status', 'createdAt']
        )
        && request.resource.data.clientEmail is string
        && request.resource.data.status == 'intake';

      allow read: if resource.data.clientEmail == 'demo@syncops.studio'
        || (isSignedIn() && request.auth.token.email == resource.data.clientEmail);

      // Milestone/stage transitions happen via the Studio Console only.
      allow update: if isOwner();
      allow delete: if isOwner();

      // Lead Architect <-> Client encrypted channel
      match /messages/{messageId} {
        allow read: if resource.data.orderId == orderId
          && (get(/databases/$(database)/documents/orders/$(orderId)).data.clientEmail == 'demo@syncops.studio'
              || ownsOrder(orderId));
        allow create: if isSignedIn()
          && request.resource.data.keys().hasAll(['orderId', 'sender', 'body', 'createdAt'])
          && request.resource.data.orderId == orderId
          && request.resource.data.sender in ['client', 'architect'];
        allow update, delete: if false;
      }

      // Scope revision requests
      match /revisions/{revisionId} {
        allow read: if ownsOrder(orderId);
        allow create: if ownsOrder(orderId)
          && request.resource.data.keys().hasAll(['type', 'details', 'createdAt', 'status'])
          && request.resource.data.status == 'pending';
        allow update, delete: if false;
      }
    }

    // Public proof: verified historical metrics
    match /case_studies/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Operational audit trail — owner eyes only
    match /audit_logs/{docId} {
      allow read: if isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }
  }
}
